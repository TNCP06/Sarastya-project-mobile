<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security configuration.

  Android 9+ (API 28) blocks cleartext (HTTP) traffic by default. The ProjekTask
  backend runs on plain HTTP at http://18.143.171.142:8080, so we must explicitly
  opt that single host in. We do NOT enable cleartext globally — every other host
  still requires HTTPS, which keeps the app secure while allowing the test backend.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">18.143.171.142</domain>
    </domain-config>
</network-security-config>
